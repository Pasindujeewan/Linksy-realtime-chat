{
  "info": {
    "_postman_id": "4b5df39d-fef2-4c7e-8938-b92f0275e9f1",
    "name": "Linksy API",
    "description": "HTTP smoke and functional requests for the Linksy Express API. Set baseUrl and use the Postman cookie jar for accessToken. Registration requires an uploadToken from the profile-image request. Socket.IO events are documented in qa/test-cases/.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": "REPLACE_WITH_AUTHENTICATED_USER_ID"
    },
    {
      "key": "otherUserId",
      "value": "REPLACE_WITH_OTHER_USER_ID"
    },
    {
      "key": "conversationId",
      "value": "REPLACE_WITH_CONVERSATION_ID"
    },
    {
      "key": "uploadToken",
      "value": "REPLACE_WITH_UPLOAD_TOKEN"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Upload profile image (before registration)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/upload/profile-image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "upload",
                "profile-image"
              ]
            },
            "description": "Select an allowed image file (maximum 5 MB). Copy data.data.uploadToken into the uploadToken collection variable."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"linksy_test_user\",\n  \"email\": \"linksy-test@example.com\",\n  \"password\": \"ReplaceWithTestPassword123\",\n  \"imageToken\": \"{{uploadToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"linksy-test@example.com\",\n  \"password\": \"ReplaceWithTestPassword123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "The response sets an accessToken cookie. Postman should send it on later requests to the same host."
          }
        },
        {
          "name": "Google sign-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"REPLACE_WITH_GOOGLE_TEST_ID_TOKEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "google"
              ]
            },
            "description": "Requires a valid ID token from the configured Google test identity provider."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List other users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/others?page=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "others"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "Search users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/search?username=linksy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "search"
              ],
              "query": [
                {
                  "key": "username",
                  "value": "linksy"
                }
              ]
            }
          }
        },
        {
          "name": "Get public user profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/{{otherUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "{{otherUserId}}"
              ]
            }
          }
        },
        {
          "name": "Get user profile by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/me/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "me",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Update own profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bio\": \"Linksy QA test profile\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/user/me/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "me",
                "{{userId}}"
              ]
            },
            "description": "Only update a profile whose ID matches the authenticated user."
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Get conversation messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/conversations/{{conversationId}}/messages?limit=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "conversations",
                "{{conversationId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Requires a conversation ID for a conversation the authenticated user belongs to. For cursor pagination, supply both beforeCreatedAt and beforeId."
          }
        }
      ]
    }
  ]
}
